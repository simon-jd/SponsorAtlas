            </column>
            <column name="[comparison_estimate_count]" datatype="real" role="measure" type="quantitative" caption="comparison estimate count">
              <calculation class="tableau" formula="SUM(IF [comparison_match] THEN 1 ELSE 0 END)" />
            </column>
            <column name="[comparison_oews_median]" datatype="real" role="measure" type="quantitative" caption="comparison oews median">
              <calculation class="tableau" formula="IF [comparison_estimate_count]=1 THEN MAX(IF [comparison_match] THEN [annual_median_wage] END) END" />
            </column>
            <column name="[comparison_status]" datatype="string" role="measure" type="nominal" caption="comparison status">
              <calculation class="tableau" formula="&quot;SOC &quot; + [Parameters].[Comparison SOC] + &quot; | Area &quot; + [Parameters].[Comparison Area] + &quot; | OEWS survey &quot; + STR([Parameters].[Comparison Survey Year]) + &quot; | &quot; + (IF NOT ([Parameters].[Comparison Area]=&quot;1:99&quot; OR (LEFT([Parameters].[Comparison Area],2)=&quot;4:&quot; AND LEN([Parameters].[Comparison Area])=7)) THEN &quot;Not comparable: unsupported area&quot; ELSEIF [comparison_estimate_count]=0 THEN &quot;No matching published estimate&quot; ELSEIF [comparison_estimate_count]&lt;&gt;1 THEN &quot;Multiple estimates: benchmark unavailable&quot; ELSEIF ISNULL([comparison_oews_median]) THEN &quot;Suppressed/top-coded: benchmark unavailable&quot; ELSE &quot;One official annual median; survey year is not LCA FY&quot; END)" />
            </column>
            <column-instance column="[comparison_status]" derivation="User" name="[usr:comparison_status:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column name="[Comparison SOC]" caption="Shared detailed SOC (e.g. 15-1252)" datatype="string" role="measure" type="nominal" value="&quot;15-1252&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;15-1252&quot;" />
            </column>
            <column name="[Comparison Area]" caption="Shared area: 1:99 national or 4:CBSA (e.g. 4:35620)" datatype="string" role="measure" type="nominal" value="&quot;1:99&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;1:99&quot;" />
            </column>
            <column name="[Comparison FY]" caption="LCA fiscal year (0 = all archived releases)" datatype="integer" role="measure" type="quantitative" value="0" param-domain-type="any">
              <calculation class="tableau" formula="0" />
