            <column-instance column="[soc]" derivation="None" name="[none:soc:nk]" pivot="key" type="nominal" />
            <column-instance column="[metro]" derivation="None" name="[none:metro:nk]" pivot="key" type="nominal" />
            <column-instance column="[fiscal_year]" derivation="None" name="[none:fiscal_year:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[lca].[none:employer:nk]">
            <groupfilter function="level-members" level="[none:employer:nk]" />
          </filter>
          <filter class="categorical" column="[lca].[none:soc:nk]">
            <groupfilter function="level-members" level="[none:soc:nk]" />
          </filter>
          <filter class="categorical" column="[lca].[none:metro:nk]">
            <groupfilter function="level-members" level="[none:metro:nk]" />
          </filter>
          <filter class="categorical" column="[lca].[none:fiscal_year:nk]">
            <groupfilter function="level-members" level="[none:fiscal_year:nk]" />
          </filter>
          <slices>
            <column>[lca].[none:employer:nk]</column>
            <column>[lca].[none:soc:nk]</column>
            <column>[lca].[none:metro:nk]</column>
            <column>[lca].[none:fiscal_year:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[lca].[usr:case_count:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid="{78303C42-02FC-5888-A712-B8627DFEEE71}" />
    </worksheet>
