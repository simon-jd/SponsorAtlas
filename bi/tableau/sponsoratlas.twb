    <worksheet name="12 Matched official annual median">
      <layout-options>
        <title>
          <formatted-text>
            <run>12 Matched official annual median</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="wages" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="wages">
            <column name="[soc]" datatype="string" role="dimension" type="nominal" />
            <column name="[soc_major]" datatype="string" role="dimension" type="nominal" />
            <column name="[metro]" datatype="string" role="dimension" type="nominal" />
            <column name="[area]" datatype="string" role="dimension" type="nominal" />
            <column name="[survey_year]" datatype="integer" role="dimension" type="nominal" />
            <column name="[fiscal_year]" datatype="integer" role="dimension" type="nominal" />
            <column name="[occupation_level]" datatype="string" role="dimension" type="nominal" />
            <column name="[geography_level]" datatype="string" role="dimension" type="nominal" />
            <column name="[annual_median_wage]" datatype="real" role="measure" type="quantitative" />
            <column name="[median_raw]" datatype="string" role="dimension" type="nominal" />
            <column name="[wage_status]" datatype="string" role="dimension" type="nominal" />
            <column name="[annual_flag]" datatype="string" role="dimension" type="nominal" />
            <column name="[hourly_flag]" datatype="string" role="dimension" type="nominal" />
            <column name="[oews_median]" datatype="real" role="measure" type="quantitative" caption="oews median">
              <calculation class="tableau" formula="IF COUNT([soc]) = 1 THEN MAX([annual_median_wage]) END" />
            </column>
            <column name="[estimate_count]" datatype="real" role="measure" type="quantitative" caption="estimate count">
              <calculation class="tableau" formula="COUNT([soc])" />
            </column>
            <column name="[reconcile_oews_median]" datatype="real" role="measure" type="quantitative" caption="reconcile oews median">
              <calculation class="tableau" formula="IF SUM(IF [soc]=&quot;15-1252&quot; AND [area]=&quot;1:99&quot; AND [survey_year]=2025 THEN 1 ELSE 0 END)=1 THEN MAX(IF [soc]=&quot;15-1252&quot; AND [area]=&quot;1:99&quot; AND [survey_year]=2025 THEN [annual_median_wage] END) END" />
            </column>
            <column name="[comparison_match]" datatype="boolean" role="dimension" type="nominal" caption="comparison match">
              <calculation class="tableau" formula="[soc]=[Parameters].[Comparison SOC] AND ([Parameters].[Comparison Area]=&quot;1:99&quot; OR (LEFT([Parameters].[Comparison Area],2)=&quot;4:&quot; AND LEN([Parameters].[Comparison Area])=7)) AND [area]=[Parameters].[Comparison Area] AND [survey_year]=[Parameters].[Comparison Survey Year]" />
            </column>
            <column name="[comparison_estimate_count]" datatype="real" role="measure" type="quantitative" caption="comparison estimate count">
              <calculation class="tableau" formula="SUM(IF [comparison_match] THEN 1 ELSE 0 END)" />
            </column>
            <column name="[comparison_oews_median]" datatype="real" role="measure" type="quantitative" caption="comparison oews median">
              <calculation class="tableau" formula="IF [comparison_estimate_count]=1 THEN MAX(IF [comparison_match] THEN [annual_median_wage] END) END" />
            </column>
            <column name="[comparison_status]" datatype="string" role="measure" type="nominal" caption="comparison status">
              <calculation class="tableau" formula="&quot;SOC &quot; + [Parameters].[Comparison SOC] + &quot; | Area &quot; + [Parameters].[Comparison Area] + &quot; | OEWS survey &quot; + STR([Parameters].[Comparison Survey Year]) + &quot; | &quot; + (IF NOT ([Parameters].[Comparison Area]=&quot;1:99&quot; OR (LEFT([Parameters].[Comparison Area],2)=&quot;4:&quot; AND LEN([Parameters].[Comparison Area])=7)) THEN &quot;Not comparable: unsupported area&quot; ELSEIF [comparison_estimate_count]=0 THEN &quot;No matching published estimate&quot; ELSEIF [comparison_estimate_count]&lt;&gt;1 THEN &quot;Multiple estimates: benchmark unavailable&quot; ELSEIF ISNULL([comparison_oews_median]) THEN &quot;Suppressed/top-coded: benchmark unavailable&quot; ELSE &quot;One official annual median; survey year is not LCA FY&quot; END)" />
            </column>
            <column-instance column="[comparison_oews_median]" derivation="User" name="[usr:comparison_oews_median:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column name="[Comparison SOC]" caption="Shared detailed SOC (e.g. 15-1252)" datatype="string" role="measure" type="nominal" value="&quot;15-1252&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;15-1252&quot;" />
            </column>
            <column name="[Comparison Area]" caption="Shared area: 1:99 national or 4:CBSA (e.g. 4:35620)" datatype="string" role="measure" type="nominal" value="&quot;1:99&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;1:99&quot;" />
            </column>
            <column name="[Comparison FY]" caption="LCA fiscal year (0 = all archived releases)" datatype="integer" role="measure" type="quantitative" value="0" param-domain-type="any">
              <calculation class="tableau" formula="0" />
            </column>
            <column name="[Comparison Survey Year]" caption="OEWS survey year (independent of LCA FY)" datatype="integer" role="measure" type="quantitative" value="2025" param-domain-type="any">
              <calculation class="tableau" formula="2025" />
            </column>
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[wages].[usr:comparison_oews_median:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid="{E7D45873-E3E0-589B-833E-FEF54C6F693B}" />
    </worksheet>
    <worksheet name="13 Comparison LCA scope">
      <layout-options>
        <title>
          <formatted-text>
            <run>13 Comparison LCA scope</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="lca" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="lca">
            <column name="[case_number]" datatype="string" role="dimension" type="nominal" />
            <column name="[is_certified]" datatype="boolean" role="dimension" type="nominal" />
            <column name="[annual_wage]" datatype="real" role="measure" type="quantitative" />
            <column name="[employer]" datatype="string" role="dimension" type="nominal" />
            <column name="[soc_major]" datatype="string" role="dimension" type="nominal" />
            <column name="[soc]" datatype="string" role="dimension" type="nominal" />
            <column name="[metro]" datatype="string" role="dimension" type="nominal" />
            <column name="[fiscal_year]" datatype="integer" role="dimension" type="nominal" />
            <column name="[employer_history_status]" datatype="string" role="dimension" type="nominal" />
            <column name="[case_count]" datatype="real" role="measure" type="quantitative" caption="case count">
              <calculation class="tableau" formula="COUNT([case_number])" />
            </column>
            <column name="[certified_rate]" datatype="real" role="measure" type="quantitative" caption="certified rate">
              <calculation class="tableau" formula="SUM(IF [is_certified] THEN 1 ELSE 0 END) / COUNT([case_number])" />
            </column>
            <column name="[wage_p50]" datatype="real" role="measure" type="quantitative" caption="wage p50">
              <calculation class="tableau" formula="PERCENTILE([annual_wage], 0.5)" />
            </column>
            <column name="[wage_p75]" datatype="real" role="measure" type="quantitative" caption="wage p75">
              <calculation class="tableau" formula="PERCENTILE([annual_wage], 0.75)" />
            </column>
            <column name="[wage_p90]" datatype="real" role="measure" type="quantitative" caption="wage p90">
              <calculation class="tableau" formula="PERCENTILE([annual_wage], 0.9)" />
            </column>
            <column name="[comparison_match]" datatype="boolean" role="dimension" type="nominal" caption="comparison match">
              <calculation class="tableau" formula="[soc]=[Parameters].[Comparison SOC] AND ([Parameters].[Comparison Area]=&quot;1:99&quot; OR (LEFT([Parameters].[Comparison Area],2)=&quot;4:&quot; AND LEN([Parameters].[Comparison Area])=7)) AND ([Parameters].[Comparison Area]=&quot;1:99&quot; OR [metro]=MID([Parameters].[Comparison Area],3,5)) AND ([Parameters].[Comparison FY]=0 OR [fiscal_year]=[Parameters].[Comparison FY])" />
            </column>
            <column name="[comparison_wage_p50]" datatype="real" role="measure" type="quantitative" caption="comparison wage p50">
              <calculation class="tableau" formula="PERCENTILE(IF [comparison_match] THEN [annual_wage] END, 0.5)" />
            </column>
            <column name="[comparison_wage_p75]" datatype="real" role="measure" type="quantitative" caption="comparison wage p75">
              <calculation class="tableau" formula="PERCENTILE(IF [comparison_match] THEN [annual_wage] END, 0.75)" />
            </column>
            <column name="[comparison_wage_p90]" datatype="real" role="measure" type="quantitative" caption="comparison wage p90">
              <calculation class="tableau" formula="PERCENTILE(IF [comparison_match] THEN [annual_wage] END, 0.9)" />
            </column>
            <column name="[comparison_scope]" datatype="string" role="measure" type="nominal" caption="comparison scope">
              <calculation class="tableau" formula="&quot;SOC &quot; + [Parameters].[Comparison SOC] + &quot; | Area &quot; + [Parameters].[Comparison Area] + &quot; | LCA FY &quot; + (IF [Parameters].[Comparison FY]=0 THEN &quot;all archived&quot; ELSE STR([Parameters].[Comparison FY]) END) + &quot; | &quot; + (IF NOT ([Parameters].[Comparison Area]=&quot;1:99&quot; OR (LEFT([Parameters].[Comparison Area],2)=&quot;4:&quot; AND LEN([Parameters].[Comparison Area])=7)) THEN &quot;Not comparable: no LCA mapping for state/nonmetropolitan/unknown area&quot; ELSEIF COUNT(IF [comparison_match] THEN [annual_wage] END)=0 THEN &quot;No matched non-null LCA wages&quot; ELSE &quot;Matched national/CBSA LCA wages&quot; END)" />
            </column>
            <column-instance column="[comparison_scope]" derivation="User" name="[usr:comparison_scope:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column name="[Comparison SOC]" caption="Shared detailed SOC (e.g. 15-1252)" datatype="string" role="measure" type="nominal" value="&quot;15-1252&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;15-1252&quot;" />
            </column>
            <column name="[Comparison Area]" caption="Shared area: 1:99 national or 4:CBSA (e.g. 4:35620)" datatype="string" role="measure" type="nominal" value="&quot;1:99&quot;" param-domain-type="any">
              <calculation class="tableau" formula="&quot;1:99&quot;" />
            </column>
            <column name="[Comparison FY]" caption="LCA fiscal year (0 = all archived releases)" datatype="integer" role="measure" type="quantitative" value="0" param-domain-type="any">
              <calculation class="tableau" formula="0" />
            </column>
            <column name="[Comparison Survey Year]" caption="OEWS survey year (independent of LCA FY)" datatype="integer" role="measure" type="quantitative" value="2025" param-domain-type="any">
              <calculation class="tableau" formula="2025" />
            </column>
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[lca].[usr:comparison_scope:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
      <simple-id uuid="{DA68BBC4-AA4D-59A7-9514-FDDED76CFA76}" />
    </worksheet>
