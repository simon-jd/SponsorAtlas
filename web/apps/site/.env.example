# Server runtime only. Inject the same strong secret into Cube and this app.
CUBE_REST_URL=http://127.0.0.1:4100/cubejs-api/v1/load
CUBEJS_API_SECRET=replace-with-a-random-server-only-secret-at-least-32-characters
# Explicit selection, never automatic failover: parquet | snowflake
SITE_DATA_SOURCE=parquet
# Required for Parquet: SHA-256 of the verified public LCA projection from export-evidence.json.
SITE_SNAPSHOT_SHA=
# Required for fixture/Snowflake: immutable dataset revision identifier.
# Change this whenever replacing/reconfiguring that dataset; no automatic fallback.
SITE_SOURCE_VERSION=
# Finite server fetch cache lifetime (1..3600 seconds); source refresh is separate.
CUBE_REVALIDATE_SECONDS=60

# Native visualizations use the same server-only Cube URL/secret and source identity.
# With SITE_DATA_SOURCE=snowflake, SITE_SOURCE_VERSION must exactly match
# SEMANTIC_H3_SOURCE_VERSION on the native gateway with SEMANTIC_H3_ENABLED=1.

# Task15 RUM is opt-in. Never put these server settings behind NEXT_PUBLIC_.
# RUM_ENABLED=1
# RUM_ORIGIN=https://<exact-public-site-host>
# RUM_STORAGE=azure-blob
# RUM_BLOB_SAS_URL=https://<account>.blob.core.windows.net/vitals/vitals.json?<private-blob-rcw-SAS>
# Local QA only, explicitly ephemeral, never a production fallback:
# RUM_STORAGE=local
# RUM_QA_ONLY=1
# RUM_LOCAL_DIR=/absolute/project-local/qa-directory
# Deployment only: immutable server-side map projection, not a public directory.
# SITE_VIZ_DIRECTORY=/absolute/deployed/viz
