terraform {
  required_version = ">= 1.11.0, < 2.0.0"
  required_providers {
    airbyte = { source = "airbytehq/airbyte", version = "= 1.3.0" }
  }
  # Configure an encrypted, access-controlled remote backend before real credentials.
  # configuration is sensitive in plans but private keys ARE still present in state.
}
provider "airbyte" {
  server_url    = var.airbyte_server_url
  token_url     = "${trimsuffix(var.airbyte_server_url, "/")}/applications/token"
  client_id     = var.airbyte_client_id
  client_secret = var.airbyte_client_secret
}
variable "airbyte_server_url" {
  type    = string
  default = "http://localhost:8000/api/public/v1"
  validation {
    condition     = can(regex("^(https://[^/]+|http://(localhost|127\\.0\\.0\\.1):[0-9]+)/api/public/v1/?$", var.airbyte_server_url))
    error_message = "Use the self-managed public API over HTTPS, or an SSH localhost tunnel."
  }
}
variable "airbyte_client_id" {
  type      = string
  sensitive = true
}
variable "airbyte_client_secret" {
  type      = string
  sensitive = true
}
variable "workspace_id" { type = string }
variable "snowflake_host" { type = string }
variable "snowflake_private_key" {
  type      = string
  sensitive = true
}
variable "snowflake_private_key_passphrase" {
  type      = string
  sensitive = true
  default   = ""
}
variable "postgres" {
  type = object({ host = string, port = optional(number, 5432), database = string,
    username = string, password = string, ca_certificate = string
  })
  sensitive = true
}
variable "file_releases" {
  description = "Generated by archive_sources after successful immutable archival, never upstream mutable links."
  type        = map(object({ schema = string, stream = string, url = string }))
  default     = {}
  validation {
    condition = alltrue([for v in values(var.file_releases) :
      contains(["LCA", "USCIS", "BLS"], v.schema) && can(regex("^[A-Z][A-Z0-9_]+$", v.stream)) &&
      can(regex("^https://.+__[a-f0-9]{64}\\.jsonl$", v.url))
    ])
    error_message = "File releases require a RAW source schema, uppercase stream, and SHA256-named immutable HTTPS JSONL."
  }
}
variable "boards" {
  description = "Stable connection keys determine RAW.JOBS.<KEY>_<PROVIDER> table names. Public GET only."
  type        = map(object({ provider = string, board = string }))
  default     = {}
  validation {
    condition = alltrue([for k, v in var.boards :
      can(regex("^[a-z][a-z0-9_]{0,60}$", k)) && contains(["greenhouse", "lever", "ashby"], v.provider) &&
      can(regex("^[A-Za-z0-9_-]+$", v.board))
    ])
    error_message = "Use stable lowercase board keys, provider greenhouse/lever/ashby, and a URL-safe board token."
  }
}
