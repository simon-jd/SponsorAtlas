# Server-only settings; copy values into a secure runtime environment, never a browser bundle.
SEMANTIC_SOURCE=parquet
CUBEJS_API_SECRET=
# Explicit opt-in is required for any Snowflake connection. Empty dates never imply a trial.
SEMANTIC_SNOWFLAKE_OPT_IN=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=CUBE_SVC
SNOWFLAKE_ROLE=ANALYST
SNOWFLAKE_WAREHOUSE=SPONSORATLAS_XS
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_PRIVATE_KEY_FILE=
# Key encryption passphrase only; Snowflake account passwords are forbidden.
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Real UTC timestamps YYYY-MM-DDTHH:MM:SSZ, duration <=30 days; no invented defaults.
SNOWFLAKE_TRIAL_STARTED_AT=
SNOWFLAKE_TRIAL_EXPIRES_AT=
# After verified export, serve parquet explicitly with this snapshot directory.
SEMANTIC_SNAPSHOT_DIR=

# Optional immutable H3 model, isolated from the original three projections.
# SEMANTIC_H3_ENABLED=1
# SEMANTIC_H3_WORK=/absolute/project/.tools/viz/actual
# SEMANTIC_H3_RESOLUTION=3
# SEMANTIC_H3_YEAR=2025
# SEMANTIC_H3_EMPLOYER=stable_public_id
# Native named /cubejs-api/v1/h3 also requires this to match SITE_SOURCE_VERSION.
# Existing native key-pair, XS, opt-in and trial-window settings remain required.
# SEMANTIC_H3_SOURCE_VERSION=explicit-native-dataset-revision
