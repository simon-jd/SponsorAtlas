# Template for ~/.config/sponsoratlas/airflow.env, which install.sh creates with mode 0600.
# No secrets here: key files are named by path, and install.sh generates CUBEJS_API_SECRET into
# the real file only. systemd reads the real file: KEY=VALUE, no `export`, no ~ or $VAR.
# install.sh also fills in the home and project paths, and the account identifier from
# SNOWFLAKE_ACCOUNT in its environment, which the repository does not hold.

DBT_TARGET=snowflake
SPONSORATLAS_ORCHESTRATION_MODE=production
SNOWFLAKE_ACCOUNT=@SNOWFLAKE_ACCOUNT@

# DBT_SVC / TRANSFORMER (dbt/profiles.yml)
SNOWFLAKE_PRIVATE_KEY_FILE=@HOME@/.snowflake-keys/sponsoratlas/DBT_SVC.p8
# CUBE_SVC / ANALYST (runtime.cube_refresh)
SPONSORATLAS_CUBE_PRIVATE_KEY_FILE=@HOME@/.snowflake-keys/sponsoratlas/CUBE_SVC.p8
# AIRBYTE_SVC / LOADER (scripts/snowflake_live.py)
SNOWFLAKE_LOADER_PRIVATE_KEY_FILE=@HOME@/.snowflake-keys/sponsoratlas/AIRBYTE_SVC.p8
# COST_OBSERVER_SVC / COST_OBSERVER, reads SNOWFLAKE.ACCOUNT_USAGE
SNOWFLAKE_COST_OBSERVER_PRIVATE_KEY_FILE=@HOME@/.snowflake-keys/sponsoratlas/COST_OBSERVER_SVC.p8

SNOWFLAKE_TRIAL_STARTED_AT=2026-10-25T07:29:00Z
SNOWFLAKE_TRIAL_EXPIRES_AT=2026-11-24T00:00:00Z

SEMANTIC_SOURCE=snowflake
SEMANTIC_SNOWFLAKE_OPT_IN=1
SEMANTIC_WORK=@PROJECT@/.tools/semantic/snowflake-refresh
CUBEJS_API_SECRET=@GENERATED_BY_INSTALL@

# Nothing is delivered: alerts are appended to .tools/orchestration/alerts/alerts.jsonl.
SPONSORATLAS_ALERT_TRANSPORT=local_log

# [dag_processor] min_file_process_interval (Airflow default 30 s). Every parse runs dbt ls.
# Deployed units only: orchestration/run.sh leaves rehearsals at the default.
AIRFLOW__DAG_PROCESSOR__MIN_FILE_PROCESS_INTERVAL=3600
