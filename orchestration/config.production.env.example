# Explicit opt-in only. Export values securely before starting Airflow components.
# Never source this example unchanged; missing values fail at task runtime.
export SPONSORATLAS_ORCHESTRATION_MODE=production
export DBT_TARGET=snowflake
export SNOWFLAKE_ACCOUNT=
# Service key files are named after the user: ~/.snowflake-keys/sponsoratlas/<USER>.p8
# dbt: DBT_SVC / TRANSFORMER / JWT / SPONSORATLAS_XS. Never a password.
export SNOWFLAKE_PRIVATE_KEY_FILE=
# load_boards: AIRBYTE_SVC / LOADER.
export SNOWFLAKE_LOADER_PRIVATE_KEY_FILE=
# preflight metered total: COST_OBSERVER_SVC / COST_OBSERVER, reads SNOWFLAKE.ACCOUNT_USAGE.
export SNOWFLAKE_COST_OBSERVER_PRIVATE_KEY_FILE=
# Existing governed RAW, DIMENSIONS_INPUT and FACTS_INPUT mappings must be provisioned.
export SEMANTIC_SOURCE=snowflake
export SEMANTIC_SNOWFLAKE_OPT_IN=1
export SPONSORATLAS_CUBE_PRIVATE_KEY_FILE=
export SPONSORATLAS_CUBE_PRIVATE_KEY_PASSPHRASE=
# Cube refresh work directory, relative to the project root where run.sh starts Airflow. Use the
# same directory when restarting the gateway.
export SEMANTIC_WORK=.tools/semantic/snowflake-refresh
export CUBEJS_API_SECRET=
# Cube: CUBE_SVC / ANALYST / JWT / XS auto_suspend=60, validated by source.cjs.
# Trial window, UTC, exactly this format. Started 2026-10-25T07:29:00Z, ends 2026-11-24T00:00:00Z.
# preflight skips the run with under one hour left; dbt and Cube dispatch keep their own margins.
export SNOWFLAKE_TRIAL_STARTED_AT=2026-10-25T07:29:00Z
export SNOWFLAKE_TRIAL_EXPIRES_AT=2026-11-24T00:00:00Z
# Exactly one explicit alert transport. local_log only appends to
# .tools/orchestration/alerts/alerts.jsonl, marks each line LOCAL_LOG_NOT_DELIVERED and notifies
# nobody: read it with orchestration/bin/status.sh. No Slack or SMTP credentials exist today.
export SPONSORATLAS_ALERT_TRANSPORT=local_log
# Slack alternative: transport=slack plus the HTTPS webhook, which returns plain 'ok'.
# export SPONSORATLAS_ALERT_URL=
# SMTP alternative: transport=smtp plus exact host/user/password/from/to (SSL465).
# No local_http transport is accepted in production.
# Airbyte: the scheduled DAGs no longer call it and no credentials exist. Kept for reference.
# export AIRBYTE_API_URL=https://airbyte.example.invalid/api/public/v1
# export AIRBYTE_CONNECTION_ID=
# export AIRBYTE_CLIENT_ID=
# export AIRBYTE_CLIENT_SECRET=
# export SPONSORATLAS_AIRBYTE_STATE_DIR=/srv/sponsoratlas/orchestration/airbyte-state
